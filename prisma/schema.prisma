generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  VENDOR
  CUSTOMER
  APPROVER
  ADMIN
  FINANCE_PREPARER
  FINANCE_APPROVER
}

enum VendorPlan {
  ELITE   // EP — ₹24,999/yr
  GOLD    // SP — ₹14,999/yr
  BASIC   // BP — ₹4,999/yr
}

enum VendorStatus {
  PENDING_DOCUMENTS
  KYC_SUBMITTED
  KYC_UNDER_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum CertificateStatus {
  PENDING
  APPROVED
  REJECTED
  ON_HOLD
  EXPIRED
}

enum ProductStatus {
  DRAFT
  SUBMITTED_FOR_REVIEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  ON_HOLD
  SUSPENDED
}

enum OrderStatus {
  CART
  RESERVED
  PAYMENT_PENDING
  PAYMENT_FAILED
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum SubOrderStatus {
  PENDING_VENDOR_ACCEPTANCE
  ACCEPTED
  REJECTED
  PARTIAL_ACCEPTED
  ALLOCATED
  IN_PREPARATION
  QC_COMPLETE
  PACKED
  INVOICE_GENERATED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RETURN_REQUESTED
  RETURN_IN_TRANSIT
  RETURNED
  SETTLED
}

enum FulfilmentMethod {
  ONLINE    // Standard 48-72h from vendor factory
  INSTA     // TrimInsta 6-hour express
}

enum SettlementStatus {
  RETURN_WINDOW_HOLD
  EXCEPTION_HOLD
  ELIGIBLE
  BATCH_DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  DISPUTED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CouponType {
  PERCENT_OFF
  FLAT_OFF
}

enum CouponApplicableTo {
  VENDOR_PLAN_ELITE
  VENDOR_PLAN_GOLD
  VENDOR_PLAN_BASIC
  CUSTOMER_ORDER
}

enum CouponFunder {
  PLATFORM   // DP — platform-funded
  VENDOR     // DV — vendor-funded
}

enum ReturnReason {
  QUALITY_DEFECT
  WRONG_ITEM_SHIPPED
  QUANTITY_MISMATCH
  DAMAGED_IN_TRANSIT
  NOT_AS_DESCRIBED
  BUYER_CHANGED_MIND
  OTHER
}

enum RmaStatus {
  INITIATED
  PICKUP_SCHEDULED
  IN_TRANSIT
  RECEIVED_AT_HUB
  INSPECTION_PENDING
  REFUND_APPROVED
  REPLACEMENT_APPROVED
  CLOSED
  REJECTED
}

enum EscalationStatus {
  OPEN
  UNDER_NEGOTIATION
  PARTIALLY_RESOLVED
  RESOLVED
  ARCHIVED
}

enum NotificationChannel {
  EMAIL
  IN_PORTAL
  SMS
}

enum NotificationType {
  OTP
  APPROVAL
  REJECTION
  ON_HOLD
  LOW_STOCK
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_SHIPPED
  ORDER_DELIVERED
  RETURN_INITIATED
  SETTLEMENT_READY
  ESCALATION
  SYSTEM
}

// ─────────────────────────────────────────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  userId        String    @unique // VN-89420, CUS-1001, APR-01, ROOT-01
  email         String    @unique
  passwordHash  String
  role          Role
  isActive      Boolean   @default(true)
  mfaSecret     String?   // TOTP secret for Admin
  mfaEnabled    Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  vendor        Vendor?
  customer      Customer?
  approver      Approver?
  otpTokens     OtpToken[]
  sessions      UserSession[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

model UserSession {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model OtpToken {
  id          String   @id @default(cuid())
  userId      String?
  email       String
  otp         String   // hashed
  purpose     String   // REGISTRATION, PASSWORD_RESET, etc.
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("otp_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// VENDOR
// ─────────────────────────────────────────────────────────────────────────────

model Vendor {
  id                String        @id @default(cuid())
  userId            String        @unique
  vendorCode        String        @unique // VN-89420
  companyName       String
  gstin             String        @unique
  pan               String
  gstVerifiedAt     DateTime?
  panVerifiedAt     DateTime?
  gstVerifiedBy     String?       // API provider + timestamp
  panVerifiedBy     String?
  status            VendorStatus  @default(PENDING_DOCUMENTS)
  plan              VendorPlan    @default(BASIC)
  planActivatedAt   DateTime?
  planExpiresAt     DateTime?
  registrationFee   Decimal       @db.Decimal(12,2) @default(0)
  planFee           Decimal       @db.Decimal(12,2) @default(0)
  triminstaEnabled  Boolean       @default(false)
  triminstaAreaSqft Decimal?      @db.Decimal(10,2)
  triminstaMonthlyRent Decimal?   @db.Decimal(12,2)
  triminstaHubLocation String?    // Bhiwandi, Tiruppur
  phone             String
  phoneCountryCode  String        @default("+91")
  address           String?
  city              String?
  state             String?
  pincode           String?
  website           String?
  managedByAdmin    Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id])
  certificates      VendorCertificate[]
  capabilities      VendorCapability[]
  products          Product[]
  onboardingInvoice OnboardingInvoice?
  subOrders         SubOrder[]
  settlementBatchItems SettlementBatchItem[]
  escalations       Escalation[]
  stockAlerts       StockAlert[]

  @@map("vendors")
}

model VendorCertificate {
  id               String            @id @default(cuid())
  vendorId         String
  certType         String            // GOTS, ISO9001, OEKO-TEX, FSC, GINETEX, REACH, AZO-FREE, OBP
  certNumber       String?
  issuingBody      String?
  issueDate        DateTime?
  expiryDate       DateTime?
  fileUrl          String?
  fileName         String?
  status           CertificateStatus @default(PENDING)
  approverComment  String?
  approvedBy       String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  onHoldAt         DateTime?
  uploadedAt       DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_certificates")
}

model VendorCapability {
  id             String        @id @default(cuid())
  vendorId       String
  categoryId     String
  subcategoryId  String?
  productId      String?
  leadTimeDays   Int?
  moq            Int?
  isActive       Boolean       @default(true)
  status         ProductStatus @default(DRAFT)
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewNote     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  vendor   Vendor   @relation(fields: [vendorId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([vendorId, subcategoryId])
  @@map("vendor_capabilities")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────────────────────────────────────

model Classification {
  id          String     @id @default(cuid())
  code        String     @unique // 1, 2, 3, 4
  name        String     // Labels & Tags, Core Garment Trims, etc.
  description String?
  iconName    String?
  colorClass  String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())

  categories Category[]

  @@map("classifications")
}

model Category {
  id               String   @id @default(cuid())
  classificationId String
  code             String   @unique // 01, 02, ... 12
  name             String
  description      String?
  iconName         String?
  colorClass       String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  classification   Classification @relation(fields: [classificationId], references: [id])
  subcategories    Subcategory[]
  capabilities     VendorCapability[]

  @@map("categories")
}

model Subcategory {
  id          String   @id @default(cuid())
  categoryId  String
  code        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  category    Category  @relation(fields: [categoryId], references: [id])
  products    Product[]

  @@unique([categoryId, code])
  @@map("subcategories")
}

model Product {
  id              String        @id @default(cuid())
  vendorId        String?       // null = catalog template
  subcategoryId   String
  sku             String        @unique
  name            String
  description     String?
  hsnCode         String
  baseUnitPrice   Decimal       @db.Decimal(12,2)
  currency        String        @default("INR")
  uom             String        // cone, piece, meter, kg, roll, pack, etc.
  moq             Int           @default(1)
  packMultiple    Int           @default(1)
  gstRate         Decimal       @db.Decimal(5,2) @default(18.00)
  materialComp    String?
  countTicketSize String?
  tensileStrength String?
  elongation      String?
  needleSize      String?
  compliance      String?
  status          ProductStatus @default(DRAFT)
  isTemplate      Boolean       @default(false) // catalog master templates
  imageUrls       String[]
  techDataSheet   String?
  onlineStock     Int           @default(0)
  triminstaStock  Int           @default(0)
  triminstaEnabled Boolean      @default(false)
  isFeatured      Boolean       @default(false)
  sortOrder       Int           @default(0)
  version         Int           @default(1) // for commercial snapshot freeze
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  vendor         Vendor?           @relation(fields: [vendorId], references: [id])
  subcategory    Subcategory       @relation(fields: [subcategoryId], references: [id])
  pricingTiers   ProductPricingTier[]
  marginSlabs    MarginSlab[]
  cartItems      CartItem[]
  orderLineItems OrderLineItem[]
  stockReservations StockReservation[]
  stockAlerts    StockAlert[]

  @@map("products")
}

model ProductPricingTier {
  id          String   @id @default(cuid())
  productId   String
  minQty      Int
  maxQty      Int?     // null = unlimited
  unitPrice   Decimal  @db.Decimal(12,2)
  savePct     Decimal? @db.Decimal(5,2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_pricing_tiers")
}

// 5-Slab Margin Matrix (Admin/Approver configured, Vendor read-only)
model MarginSlab {
  id              String   @id @default(cuid())
  productId       String
  slabNumber      Int      // 1-5
  label           String   // "SLAB 1 (<50)", etc.
  minQty          Int
  maxQty          Int?
  marginPct       Decimal  @db.Decimal(6,3)   // e.g., 8.500 = 8.5%
  vendorNetPct    Decimal  @db.Decimal(6,3)   // 100 - marginPct
  agreedStatus    String?  // AGREED, DISAGREEMENT, PENDING
  disputeNote     String?
  setByApprover   String?
  setAt           DateTime?
  isActive        Boolean  @default(true)
  appliesFrom     DateTime @default(now()) // MAR-03: applies only to future orders
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, slabNumber])
  @@map("margin_slabs")
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMER
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(cuid())
  userId         String   @unique
  customerCode   String   @unique  // CUS-1001
  companyName    String
  gstin          String?
  pan            String?
  contactName    String?
  phone          String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  deliveryAddress Json?   // Array of delivery addresses
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  carts   Cart[]
  orders  Order[]

  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────────
// APPROVER
// ─────────────────────────────────────────────────────────────────────────────

model Approver {
  id          String   @id @default(cuid())
  userId      String   @unique
  approverCode String  @unique  // APR-01
  name        String
  designation String?
  isActive    Boolean  @default(true)
  invitedBy   String?
  invitedAt   DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@map("approvers")
}

// ─────────────────────────────────────────────────────────────────────────────
// CART & STOCK RESERVATION
// ─────────────────────────────────────────────────────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  customerId String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer   @relation(fields: [customerId], references: [id])
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id               String           @id @default(cuid())
  cartId           String
  productId        String
  quantity         Int
  fulfilmentMethod FulfilmentMethod @default(ONLINE)
  unitPrice        Decimal          @db.Decimal(12,2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("cart_items")
}

model StockReservation {
  id               String           @id @default(cuid())
  productId        String
  quantity         Int
  fulfilmentMethod FulfilmentMethod
  reservedForCart  String?
  reservedForOrder String?
  expiresAt        DateTime         // 15-minute reservation window
  releasedAt       DateTime?
  isConfirmed      Boolean          @default(false)
  createdAt        DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@map("stock_reservations")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORDERS & PAYMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique // ORD-2026-00001
  customerId          String
  status              OrderStatus   @default(CART)
  subtotal            Decimal       @db.Decimal(14,2)
  totalGst            Decimal       @db.Decimal(14,2)
  totalShipping       Decimal       @db.Decimal(14,2)
  platformDiscount    Decimal       @db.Decimal(14,2) @default(0) // DP coupon
  vendorDiscount      Decimal       @db.Decimal(14,2) @default(0) // DV coupon
  totalAmount         Decimal       @db.Decimal(14,2)
  couponCode          String?
  couponId            String?
  razorpayOrderId     String?       @unique
  razorpayPaymentId   String?
  razorpaySignature   String?
  paymentStatus       PaymentStatus @default(PENDING)
  paymentCapturedAt   DateTime?
  deliveryAddress     Json
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer  Customer   @relation(fields: [customerId], references: [id])
  subOrders SubOrder[]
  coupon    Coupon?    @relation(fields: [couponId], references: [id])

  @@map("orders")
}

model SubOrder {
  id                   String          @id @default(cuid())
  subOrderNumber       String          @unique // ORD-2026-00001-V1
  orderId              String
  vendorId             String
  fulfilmentMethod     FulfilmentMethod
  status               SubOrderStatus  @default(PENDING_VENDOR_ACCEPTANCE)
  subtotal             Decimal         @db.Decimal(14,2)
  totalGst             Decimal         @db.Decimal(14,2)
  shippingCharge       Decimal         @db.Decimal(14,2) @default(0)
  vendorDiscount       Decimal         @db.Decimal(14,2) @default(0)
  totalAmount          Decimal         @db.Decimal(14,2)
  vendorAcceptedAt     DateTime?
  vendorRejectedAt     DateTime?
  vendorRejectionNote  String?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  returnDeadline       DateTime?       // deliveredAt + 10 days
  trackingNumber       String?
  trackingCarrier      String?
  invoiceUrl           String?
  invoiceNumber        String?
  sellerInvoiceNumber  String?
  listingVersion       Int             // snapshot of product version at order time
  slabMarginPct        Decimal         @db.Decimal(6,3)
  commissionAmount     Decimal         @db.Decimal(12,2)
  netVendorPayable     Decimal         @db.Decimal(12,2)
  settlementStatus     SettlementStatus @default(RETURN_WINDOW_HOLD)
  settlementEligibleAt DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  order          Order          @relation(fields: [orderId], references: [id])
  vendor         Vendor         @relation(fields: [vendorId], references: [id])
  lineItems      OrderLineItem[]
  rmaRequests    RmaRequest[]
  settlementItems SettlementBatchItem[]

  @@map("sub_orders")
}

model OrderLineItem {
  id               String           @id @default(cuid())
  subOrderId       String
  productId        String
  productSnapshot  Json             // Frozen commercial snapshot at order time
  sku              String
  hsnCode          String
  productName      String
  quantity         Int
  unitPrice        Decimal          @db.Decimal(12,2)
  gstRate          Decimal          @db.Decimal(5,2)
  gstAmount        Decimal          @db.Decimal(12,2)
  lineTotal        Decimal          @db.Decimal(14,2)
  fulfilmentMethod FulfilmentMethod
  slabNumber       Int
  marginPct        Decimal          @db.Decimal(6,3)
  commissionAmt    Decimal          @db.Decimal(12,2)
  netVendorAmt     Decimal          @db.Decimal(12,2)
  returnedQty      Int              @default(0)
  createdAt        DateTime         @default(now())

  subOrder SubOrder @relation(fields: [subOrderId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@map("order_line_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// RETURNS & RMA
// ─────────────────────────────────────────────────────────────────────────────

model RmaRequest {
  id              String       @id @default(cuid())
  rmaNumber       String       @unique // RMA-2026-00001
  subOrderId      String
  reason          ReturnReason
  description     String?
  evidenceUrls    String[]
  status          RmaStatus    @default(INITIATED)
  inspectionNotes String?
  resolutionType  String?      // REFUND, REPLACEMENT
  resolutionAmt   Decimal?     @db.Decimal(12,2)
  resolvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  subOrder SubOrder @relation(fields: [subOrderId], references: [id])

  @@map("rma_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// SETTLEMENTS & FINANCE
// ─────────────────────────────────────────────────────────────────────────────

model SettlementBatch {
  id              String           @id @default(cuid())
  batchNumber     String           @unique // STLB-2026-001
  status          SettlementStatus @default(BATCH_DRAFT)
  preparedById    String           // Finance Preparer user ID
  approvedById    String?          // Finance Approver user ID (must differ from preparer)
  approvedAt      DateTime?
  paidAt          DateTime?
  bankUtr         String?          // UTR reference after payout
  totalAmount     Decimal          @db.Decimal(14,2)
  itemCount       Int              @default(0)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  items SettlementBatchItem[]

  @@map("settlement_batches")
}

model SettlementBatchItem {
  id              String           @id @default(cuid())
  batchId         String?
  subOrderId      String
  vendorId        String
  grossAmount     Decimal          @db.Decimal(12,2)
  commissionAmt   Decimal          @db.Decimal(12,2)
  gstOnCommission Decimal          @db.Decimal(12,2)
  tdsAmount       Decimal          @db.Decimal(12,2)
  netPayable      Decimal          @db.Decimal(12,2)
  adjustments     Decimal          @db.Decimal(12,2) @default(0)
  status          SettlementStatus @default(ELIGIBLE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  batch    SettlementBatch? @relation(fields: [batchId], references: [id])
  subOrder SubOrder         @relation(fields: [subOrderId], references: [id])
  vendor   Vendor           @relation(fields: [vendorId], references: [id])

  @@map("settlement_batch_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// ONBOARDING INVOICE
// ─────────────────────────────────────────────────────────────────────────────

model OnboardingInvoice {
  id               String   @id @default(cuid())
  invoiceNumber    String   @unique // TN-ONB-2026-00001
  vendorId         String   @unique
  registrationFee  Decimal  @db.Decimal(12,2)
  planFee          Decimal  @db.Decimal(12,2)
  triminstaFee     Decimal  @db.Decimal(12,2) @default(0)
  subtotal         Decimal  @db.Decimal(12,2)
  igst             Decimal  @db.Decimal(12,2)
  totalAmount      Decimal  @db.Decimal(12,2)
  couponCode       String?
  discountAmount   Decimal  @db.Decimal(12,2) @default(0)
  razorpayOrderId  String?
  razorpayPaymentId String?
  paymentStatus    PaymentStatus @default(PENDING)
  paidAt           DateTime?
  invoiceUrl       String?
  createdAt        DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@map("onboarding_invoices")
}

// ─────────────────────────────────────────────────────────────────────────────
// COUPONS
// ─────────────────────────────────────────────────────────────────────────────

model Coupon {
  id              String             @id @default(cuid())
  code            String             @unique
  type            CouponType
  value           Decimal            @db.Decimal(10,2)
  maxDiscountAmt  Decimal?           @db.Decimal(10,2)
  applicableTo    CouponApplicableTo
  funder          CouponFunder       @default(PLATFORM)
  vendorId        String?            // if vendor-funded
  isSingleUse     Boolean            @default(true)
  isUsed          Boolean            @default(false)
  usedAt          DateTime?
  usedByOrderId   String?
  expiresAt       DateTime?
  createdById     String
  createdAt       DateTime           @default(now())

  orders Order[]

  @@map("coupons")
}

// ─────────────────────────────────────────────────────────────────────────────
// ESCALATIONS (Admin Docket)
// ─────────────────────────────────────────────────────────────────────────────

model Escalation {
  id              String           @id @default(cuid())
  caseNumber      String           @unique // ESC-9482
  vendorId        String
  title           String
  description     String?
  status          EscalationStatus @default(OPEN)
  assignedToAdmin String?
  resolvedById    String?
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  vendor    Vendor              @relation(fields: [vendorId], references: [id])
  items     EscalationItem[]
  timeline  EscalationTimeline[]

  @@map("escalations")
}

model EscalationItem {
  id             String  @id @default(cuid())
  escalationId   String
  productId      String?
  productName    String
  sku            String?
  vendorMarginPct Decimal @db.Decimal(6,3)
  targetMarginPct Decimal @db.Decimal(6,3)
  disputeNote    String?
  status         String  // AGREED, DISPUTED, ADMIN_OVERRIDDEN
  resolvedMarginPct Decimal? @db.Decimal(6,3)
  createdAt      DateTime @default(now())

  escalation Escalation @relation(fields: [escalationId], references: [id])

  @@map("escalation_items")
}

model EscalationTimeline {
  id           String   @id @default(cuid())
  escalationId String
  actorId      String?
  actorRole    String?
  action       String
  detail       String?
  createdAt    DateTime @default(now())

  escalation Escalation @relation(fields: [escalationId], references: [id])

  @@map("escalation_timeline")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS & AUDIT
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  type      NotificationType
  channel   NotificationChannel @default(IN_PORTAL)
  subject   String
  body      String
  metadata  Json?               // OTP codes, order IDs, etc.
  isRead    Boolean             @default(false)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model StockAlert {
  id          String   @id @default(cuid())
  productId   String
  vendorId    String
  alertType   String   // LOW_STOCK, OUT_OF_STOCK
  stockLevel  Int
  threshold   Int      @default(50)
  emailSentAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  vendor  Vendor  @relation(fields: [vendorId], references: [id])

  @@map("stock_alerts")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  resource    String
  resourceId  String?
  detail      Json?
  ipAddress   String?
  hash        String?  // SHA-256 audit hash
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM CONFIG
// ─────────────────────────────────────────────────────────────────────────────

model PlatformConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("platform_config")
}

