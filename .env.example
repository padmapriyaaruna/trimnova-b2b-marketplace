# TrimNova B2B2C Marketplace — Environment Variables

# ─── DATABASE ───────────────────────────────────────────────────────────────
# Neon DB pooled connection (for Prisma Client runtime queries)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/trimnova?sslmode=require&pgbouncer=true&connect_timeout=15"
# Neon DB direct connection (for Prisma migrations/push)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/trimnova?sslmode=require"

# ─── SERVER ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
JWT_SECRET=your-jwt-secret-here-min-32-chars
JWT_EXPIRY=7d
BCRYPT_ROUNDS=10

# ─── RAZORPAY ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── CLOUDINARY ──────────────────────────────────────────────────────────────
# Optional — omit to use local base64 fallback
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── BREVO (EMAIL / OTP) ─────────────────────────────────────────────────────
# Optional — omit to use in-portal Demo Mail Inspector fallback
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=noreply@trimnova.in
BREVO_SENDER_NAME=TrimNova Platform

# ─── OTP / TOTP ──────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
TOTP_WINDOW=1

# ─── FRONTEND (Vite) ─────────────────────────────────────────────────────────
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
VITE_API_BASE_URL=http://localhost:5000/api/v1

